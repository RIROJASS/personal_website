}

@article{agyemang2026credential,
  abbr        = {Credentials},
  bibtex_show = {true},
  title       = {Credential Farming in the Age of Generative {AI}: Relocating Trust from Outputs to Communities},
  author      = {Agyemang, Gift Osei and AL-Louzi, Rawad and Bawoke, Melat Mezgebu and Bender, Connor and Celi, Leo Anthony and Chavan, Nishita and Gorijavolu, Rahul and Halac, Diego and Jaiswal, Nikhil and Mikolutskaya, Sofiya and Nguyen, Anthony and Rojas Sillery, Raúl Ignacio and Roy, Sparsh and Suresha, Dharaa and Xiang, Alexa Q. and Zhang, Boya},
  journal     = {Manuscript submitted},
  year        = {2026},
  selected    = {true},
  abstract    = {Credentials began as proxies for competence, but generative AI has weakened the inference from research outputs to the capacities those outputs were meant to signal — producing a gaming dynamic in which effort shifts toward optimizing the signal rather than the learning it was supposed to represent. The paper argues academic trust must relocate from manufactured outputs to formation inside research communities. Authors listed alphabetically by surname.},
  additional_info = {. <strong>Status:</strong> submitted.},
}

